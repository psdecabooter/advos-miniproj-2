\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Apparatus and method}{1}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Choosing a clock}{1}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Clock granularity over $10^6$ consecutive reads. ``Zero deltas'' is the fraction of adjacent readings that were identical; the last column is what a call of cost $c$ against a quantum $q$ predicts. The agreement is the point: a high fraction measures a call that is cheap relative to one tick, not a clock that is coarse. Only \texttt  {gettimeofday} is disqualified, and by its \SI {1}{\micro \second } quantum rather than by its zero fraction.}}{2}{}\protected@file@percent }
\newlabel{tab:clocks}{{1}{2}{}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Latency}{2}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces One-way latency (half round trip), minimum of five runs. The flat region below \SI {4}{KiB} is fixed cost per exchange; the constant gap between same-core and cross-core is \SI {1333}{ns}. The dashed line is the fixed-cost-plus-linear-copy model fitted to the same-core endpoints.}}{2}{}\protected@file@percent }
\newlabel{fig:latency}{{1}{2}{}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces One-way latency by payload and placement, minimum of five runs. The data behind Figure~\ref {fig:latency}.}}{2}{}\protected@file@percent }
\newlabel{tab:lat}{{2}{2}{}{table.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Throughput}{2}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Streaming throughput at the default \SI {64}{KiB} capacity (dashed line). Only the cross-core curve collapses; the same-core curve saturates and stays flat well past capacity, although its writer blocks just as often.}}{3}{}\protected@file@percent }
\newlabel{fig:thr}{{2}{3}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cross-core throughput with the pipe capacity set by \texttt  {F\_SETPIPE\_SZ}, one curve per capacity, light to dark. The knee tracks the configured size, which establishes capacity as the cause rather than a correlate.}}{3}{}\protected@file@percent }
\newlabel{fig:resize}{{3}{3}{}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Streaming throughput by chunk size and placement, best of five runs. The data behind Figure~\ref {fig:thr}.}}{3}{}\protected@file@percent }
\newlabel{tab:thr}{{3}{3}{}{table.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Where the time goes}{3}{}\protected@file@percent }
\newlabel{sec:time}{{6}{3}{}{section.6}{}}
